+        ]:
+            if not hasattr(_real_nl, _attr) and hasattr(_stub_nl, _attr):
+                setattr(_real_nl, _attr, getattr(_stub_nl, _attr))
+        from nkilib.core.attention.attention_cte import (
+            attention_cte as _attention_cte_raw,
