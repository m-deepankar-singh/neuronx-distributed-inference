+
+        seq_len = input_ids.shape[1]
+        batch_size = input_ids.shape[0]
+
+        if llava_args and len(llava_args) >= 2:
+            vision_embeddings = llava_args[0]
+            vision_mask = llava_args[1]
+            if len(llava_args) >= 3:
